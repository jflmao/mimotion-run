name: keepalive保活
on:
  schedule:
    - cron: '17 4 * * 1'        # 每周一 04:17 UTC，留足余量
  workflow_dispatch:
permissions:
  contents: write               # push 必需
jobs:
  keepalive:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: |
          git config user.name 'github-actions[bot]'
          git config user.email 'github-actions[bot]@users.noreply.github.com'
          git commit --allow-empty -m 'chore: keepalive [skip ci]' || echo "noop"
          git push
